{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash

set -e

# Update package list
sudo apt-get update

# Install packages
{{ range .packages.linux.apts -}}
sudo apt-get install -y {{ . | quote }}
{{ end -}}

# Install pipx packages
{{ if .packages.linux.pipx -}}
export PATH="$PATH:$HOME/.local/bin"
pipx ensurepath || true
{{ range .packages.linux.pipx -}}
echo "Installing pipx package: {{ . }}"
pipx install {{ . | quote }} || pipx upgrade {{ . | quote }} || echo "Failed to install {{ . }}, continuing..."
{{ end -}}
{{ end -}}

# Set zsh as default shell
if [ "$SHELL" != "$(which zsh)" ]; then
    echo "Setting zsh as default shell..."
    chsh -s $(which zsh)
    echo "Default shell changed to zsh. Please log out and log back in for changes to take effect."
fi

# Clean up
sudo apt-get autoremove -y
sudo apt-get clean
{{ end -}}